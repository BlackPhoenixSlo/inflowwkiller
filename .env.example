# ============================================================================
# inflowwkiller — environment template.
# Copy to `.env` (gitignored) and fill in per environment. docker-compose.yml
# reads this file automatically; native runs load service/.env via dotenv.
# ============================================================================

# --- Auth -------------------------------------------------------------------
# Share-link gate. Empty = gate OFF (friend-auth cookie is the sole gate).
# Set a value to require ?t=<token>. Generate: openssl rand -hex 24
SHARE_TOKEN=

# Cookie-signing HMAC keys. REQUIRED in production — set them here so the
# secret lives only on the host. If unset, the app falls back to writing a
# random key to service/.session_secret / .chatter_secret on first boot
# (fine for local dev, NOT for a shared/public deploy). Generate each:
#   openssl rand -hex 32
SESSION_SECRET=
CHATTER_SESSION_SECRET=

# Set to 1 when serving over HTTPS so auth cookies get the Secure flag.
SESSION_COOKIE_SECURE=0

# --- Database ---------------------------------------------------------------
# App (SQLAlchemy async) connection string. SQLite default; switch to
# postgresql+asyncpg://... to scale.
DATABASE_URL=sqlite+aiosqlite:///./service/chatterly.db

# Alembic reads CHATTERLY_DB_URL, NOT DATABASE_URL — keep them pointed at the
# SAME database or migrations silently target the wrong file.
CHATTERLY_DB_URL=sqlite:///./service/chatterly.db

# --- LLM providers (service/llm_client.py) ----------------------------------
# DeepSeek is the house default model. Grok is optional/legacy.
DEEPSEEK_API_KEY=
GROK_API_KEY=

# --- Automations engine -----------------------------------------------------
# Fleet-wide kill switch for the W7 webhook-priority dispatcher. Set to 1 to
# force all real-time inbound dispatch off (the per-account webhook_config_json
# gate already defaults OFF). Leave unset for normal operation.
W7_WEBHOOK_DISPATCH_DISABLED=

# --- Optional tunables (sane defaults in code; override only if needed) ------
# STORYBOARD_DIR=/app/service/storyboard_cache
# IMG_CACHE_DIR=
# IMG_CACHE_MAX_BYTES=
# IMG_CACHE_TTL_S=
# CHATTERLY_VAULT_CACHE_TTL_SECONDS=
# MAX_EMPLOYEES_PER_USER=
# PERFLOG_RETAIN_S=
# DB_ECHO=0
